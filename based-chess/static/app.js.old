let ws = null;
let playerId = null;
let playerName = null;
let currentGame = null;
let myColor = null;
let selectedSquare = null;
let validMoves = []; // Array of valid destination squares for selected piece
let boardState = {};
let gameStarted = false;
let iAmReady = false;
let countdownTimer = null;
let promotionChoices = ['q', 'n', 'r', 'b']; // queen, knight, rook, bishop
let promotionIndex = 0;
let draggedPiece = null; // Track piece being dragged
let dragStartSquare = null;
let gamesListData = {}; // Store games list data to track password protection
let allGames = []; // Store all games for client-side filtering/sorting
let currentSortColumn = null; // Current sort column ('players', 'status', null)
let sortDirection = 'asc'; // 'asc' or 'desc'
let gameEndSoundPlayed = false; // Track if end-game sound has been played for current game
let previousMoveCount = 0; // Track previous move count to detect new moves
let rematchRequested = false; // Track if we requested rematch
let rematchAccepted = false; // Track if we accepted rematch
let rematchButtonClickCount = 0; // Track rematch button clicks (3-click confirmation)
let rematchButtonOriginalText = ''; // Original rematch button text
let rematchButtonTimeout = null; // Timeout for rematch button reset
let rematchTimeoutTimer = null; // Timer for 10-second rematch timeout
let isSpectator = false; // Track if user is spectating
let spectatorViewColor = 'white'; // Default view color for spectators (can flip)
let whiteTimeRemaining = null; // Store white time remaining (seconds)
let blackTimeRemaining = null; // Store black time remaining (seconds)
let lastTimeUpdate = null; // Timestamp of last time update from server
let timerInterval = null; // Client-side countdown interval

// Bot state
let playAgainstBot = false; // Whether bot mode is enabled
let botColor = null; // Color the bot is playing ('white' or 'black')
let botThinking = false; // Whether bot is currently thinking
let botWs = null; // Second WebSocket connection for the bot
let botPlayerId = null; // Player ID of the bot connection
let botRoomId = null; // Room ID the bot should join
let botPassword = null; // Password for the bot room (if any)
