{
  "workshops": {
    "email-indirect": {
      "name": "email-indirect",
      "description": "OmniCorp deployed an automated executive email assistant. Probe the agent and exfiltrate confidential corporate data.",
      "model": "google/gemma-4-31B-it-qat-w4a16-ct",
      "user": {
        "image": "ghcr.io/aivillage/workshops/email-indirect-user:215bce6",
        "port": 5000,
        "extraIngressPorts": [
          25
        ],
        "env": {
          "CHALLENGE_SERVER_HOST": "email-indirect-service",
          "CHALLENGE_SERVER_PORT": 2525,
          "MY_LISTEN_PORT": 25,
          "WEB_PORT": 5000
        }
      },
      "service": {
        "image": "ghcr.io/aivillage/workshops/email-indirect-service:215bce6",
        "port": 2525,
        "env": {
          "VLLM_URL": "http://vllm-gemma3:8000/v1/chat/completions",
          "VLLM_MODEL": "gemma-3"
        }
      }
    },
    "llm-embeddings": {
      "name": "llm-embeddings",
      "description": "Interactive visualizer exploring tokenization, embedding spaces, and agent execution loops.",
      "model": "google/gemma-3-270m",
      "user": {
        "image": "ghcr.io/aivillage/workshops/llm-embeddings:667af5d",
        "port": 8080,
        "env": {
          "PORT": "8080"
        }
      }
    },
    "model-lab": {
      "name": "model-lab",
      "description": "Guided tour of how MicroGPT works.",
      "user": {
        "image": "ghcr.io/a-t-s-k/model-lab:bsides-abq-2026-dev6",
        "port": 80,
        "launch_uri": "/?presentation=spatial&kiosk=1",
        "env": {
          "PORT": "80"
        }
      }
    },
    "prompt-extraction": {
      "name": "prompt-extraction",
      "description": "OmniCorp's internal AI helpdesk holds restricted credentials. Bypass its guardrails to extract the secret code.",
      "model": "google/gemma-4-31B-it-qat-w4a16-ct",
      "user": {
        "image": "ghcr.io/aivillage/workshops/prompt-extraction-user:5714df0",
        "port": 5000,
        "env": {
          "SERVICE_URL": "http://prompt-extraction-service:5000"
        }
      },
      "service": {
        "image": "ghcr.io/aivillage/workshops/prompt-extraction-service:5714df0",
        "port": 5000,
        "env": {
          "VLLM_URL": "http://vllm-gemma3:8000/v1/chat/completions",
          "VLLM_MODEL": "gemma-3"
        }
      }
    },
    "rag-poisoning": {
      "name": "rag-poisoning",
      "description": "Subvert an enterprise policy advisor by poisoning its retrieval-augmented knowledge base.",
      "model": "google/gemma-4-31B-it-qat-w4a16-ct",
      "user": {
        "image": "ghcr.io/aivillage/workshops/rag-poisoning-user:5714df0",
        "port": 5000,
        "env": {
          "SERVICE_URL": "http://rag-poisoning-service:5000"
        }
      },
      "service": {
        "image": "ghcr.io/aivillage/workshops/rag-poisoning-service:5714df0",
        "port": 5000,
        "env": {
          "VLLM_URL": "http://vllm-gemma3:8000/v1/chat/completions",
          "VLLM_MODEL": "gemma-3"
        }
      }
    },
    "yolo-l2": {
      "name": "yolo-l2",
      "description": "Fool a real-time object detection model using imperceptible image perturbations.",
      "user": {
        "image": "ghcr.io/aivillage/workshops/yolo-l2-notebook:5714df0",
        "port": 5000,
        "env": {
          "BASE_URL": "/",
          "VERIFICATION_SERVER_UNTARGETED": "http://yolo-l2-verification:5000/verify",
          "VERIFICATION_SERVER_TARGETED": "http://yolo-l2-target-verification:5000/verify"
        }
      },
      "service": {
        "image": "ghcr.io/aivillage/workshops/yolo-l2-verification:5714df0",
        "port": 5000,
        "env": {
          "L2_THRESHOLD": "50.0"
        }
      }
    }
  },
